<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      注意：当前产物未启用 App Sandbox，此 entitlement 不产生实际效果——
      非沙盒应用本就允许出站 TCP。服务端模式访问内网（192.168.*）真正
      依赖的是 Info.plist 的 NSLocalNetworkUsageDescription + 用户在
      「系统设置 → 隐私与安全性 → 本地网络」里授权。
      保留此文件仅为未来启用沙箱时的备忘。
    -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>